# ─────────────────────────────────────────────────────────────
# Root .env for docker-compose.prod.yml (${VAR} interpolation).
#   cp .env.example .env && chmod 600 .env     then fill every value.
# Lines marked REQUIRED: compose refuses to start while they are missing.
# Generate every secret fresh on the server — nothing from a dev machine.
# Step-by-step guide, exact formats and traps: ENV_SETUP.md
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# REQUIRED. Goes inside DATABASE_URL, so keep it URL-safe:  openssl rand -hex 24
# (characters such as @ : / # break the URL.)
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED. At least 32 characters each, and different from each other:
#   openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Public address ───────────────────────────────────────────
# REQUIRED. The HTTPS origin users type, exactly (scheme + host, no path).
# CORS allowlist (comma-separate extra origins); the FIRST entry is the base of
# every link in emails and PDFs.
FRONTEND_URL=https://appraisal.vjstartup.com

# Where the frontend listens on this host:
#   80             — the TLS proxy is on another machine
#   127.0.0.1:8080 — the TLS proxy runs on this same host
HTTP_BIND=80

# ── Email ────────────────────────────────────────────────────
# REQUIRED. `false` sends real mail to real faculty. Use `true` on staging.
EMAIL_DISABLED=true
SMTP_HOST=smtp.gmail.com
# 587 pairs with SMTP_SECURE=false, 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail: a 16-character APP password, not the account password.
SMTP_PASS=
# Keep the quotes — the value contains < >.
SMTP_FROM="VNRVJIET Faculty Portal <sender@example.com>"

# Daily review-window mail to every opted-in faculty member, sent with nobody
# clicking anything. `false` stops it without deleting the configured windows.
QUARTERLY_AUTOSEND=true

# ── Accounts ─────────────────────────────────────────────────
# REQUIRED. Password given to faculty created by CSV bulk import.
DEFAULT_IMPORT_PASSWORD=

# ── Limits and runtime ───────────────────────────────────────
MAX_UPLOAD_MB=5
# The 09:00 jobs run in this zone.
TZ=Asia/Kolkata
LOG_LEVEL=info
# Optional: require `Authorization: Bearer <token>` on /metrics.
METRICS_TOKEN=

# ── Monitoring (only with --profile monitoring) ──────────────
# REQUIRED by compose even when the profile is off — set it anyway.
GRAFANA_PASSWORD=
PROMETHEUS_RETENTION=30d
