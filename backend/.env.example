# Copy to backend/.env and fill in. Never commit the filled-in file.
# Names here match what the code reads (process.env.*) — see SECRETS.md.

# Database.
DATABASE_URL=postgresql://appraisal_user:secure_password@localhost:5432/faculty_appraisal

# JWT & Authentication — both secrets must be at least 32 chars and differ.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=a-different-super-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS + the base URL used in email links. Comma-separated; the FIRST origin is
# what emailed links point at, so put the real public URL first.
FRONTEND_URL=http://localhost:5173

# Email Service (Gmail SMTP)
# EMAIL_DISABLED=false sends REAL mail to REAL addresses. Keep it true anywhere
# that is not production — see the mail warning in SECRETS.md.
EMAIL_DISABLED=true
# Kill switch for the daily 09:00 job that mails every opted-in faculty when a
# review window ends. Default true (it runs); set false to stop it without
# deleting the configured windows.
QUARTERLY_AUTOSEND=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
# Contains < and >, so keep it quoted.
SMTP_FROM="VNRVJIET Faculty Portal <noreply@vnrvjiet.in>"

# Per-file upload ceiling in MB (default 5). Applies to uploaded files only —
# proofs pasted as a link (Google Drive etc.) are stored as a URL and are not
# size-checked.
MAX_UPLOAD_MB=5
# Where uploaded proofs are stored (files go in <UPLOAD_DIR>/appraisals).
# Absolute, or relative to the backend folder; unset means backend/uploads.
# In production it must be a mounted volume or proofs are lost on redeploy, and
# it is NOT in the database backup — scripts/backup.sh archives it with the DB.
# UPLOAD_DIR=./uploads

# Server
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Protect the Prometheus /metrics endpoint. When set, /metrics requires
# `Authorization: Bearer <this>`; unset leaves it open (dev only — keep the
# port off the public network). Generate: openssl rand -hex 24
# METRICS_TOKEN=
