model AppraisalReview {
  id           String       @id @default(uuid())
  submissionId String       @unique
  reviewerId   String
  reviewerRole ReviewerRole

  cat1Score Float?
  cat2Score Float?
  cat3Score Float?
  cat4Score Float?
  cat5Score Float?

  cat6Punctuality     Float?
  cat6Professionalism Float?
  cat6Willingness     Float?
  cat6Cordiality      Float?
  cat6Classroom       Float?

  // The two scores an appraisal carries, frozen together at review time.
  //   selfTotalScore - what the faculty's own submission scored, out of 500
  //   totalScore     - what the reviewer awarded for categories 1-5, out of 500
  //   grandTotal     - totalScore + Category 6, out of 550 (HoD/dean only)
  // Storing the self figure matters: it is otherwise recomputed on every read,
  // so a later change to the scoring rules would silently move it while the
  // reviewed figure stayed frozen, and the pair would stop agreeing with the
  // decision that was actually signed off.
  selfTotalScore Float?
  totalScore Float?
  grandTotal Float?

  teachingComment      String?
  researchComment      String?
  developmentComment   String?
  governanceComment    String?
  supplementaryComment String?
  overallComment       String?

  status     SubmissionStatus
  reviewedAt DateTime         @default(now())

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User                @relation(fields: [reviewerId], references: [id])
}

// The HoD's provisional marks on a DRAFT appraisal during the year (owner
// decision 2026-09-19). The draft carries across all four quarters and cannot
// be submitted until the Q4 review window ends; meanwhile the HoD may verify
// proofs and note draft Cat 1-5 overrides and a draft Cat 6. These pre-fill the
// one real review after submission, where they become final. Cat 6 here obeys
// the same visibility gate as AppraisalReview (utils/reviewVisibility).
model DraftReview {
  id           String   @id @default(uuid())
  submissionId String   @unique
  reviewerId   String

  cat1Score Float?
  cat2Score Float?
  cat3Score Float?
  cat4Score Float?
  cat5Score Float?

  cat6Punctuality     Float?
  cat6Professionalism Float?
  cat6Willingness     Float?
  cat6Cordiality      Float?
  cat6Classroom       Float?

  overallComment String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// A dean-assigned final reviewer's sign-off on an annual appraisal — the review
// layer ABOVE the HoD. The admin/dean assigns exactly two per submission; both
// must APPROVE to finalise. Either REJECT sends the submission back (HOLD).
model FinalReview {
  id           String        @id @default(uuid())
  submissionId String
  reviewerId   String
  decision     FinalDecision @default(PENDING)
  comment      String?
  assignedById String?
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User                @relation("FinalReviewReviewer", fields: [reviewerId], references: [id])

  @@unique([submissionId, reviewerId])
  @@index([reviewerId])
}

model FPGPPlan {
  id             String     @id @default(uuid())
  userId         String
  academicYearId String
  status         FPGPStatus @default(DRAFT)

  // Profile snapshot at create
  designationSnap     String?
  departmentSnap      String?
