generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role hierarchy (2026-09-18 rework — docs/superpowers/plans/role-hierarchy-rework.md).
// FACULTY / HOD / REVIEWER are department-level; HOD and REVIEWER are the only
// roles that carry a departmentId. PRINCIPAL, DEAN, SCRUTINIZER,
// SPECIAL_SCRUTINIZER and ADMIN are institute-wide and never carry one.
enum RoleType {
  FACULTY
  HOD
  REVIEWER
  ADMIN // app maintenance only: accounts, roles, email queue, audit log
  PRINCIPAL // sees everything institute-wide, incl. Cat 6 and the /550 total
  DEAN // configuration, tier allocation, assigns scrutinizers
  SCRUTINIZER // cross-department final-review pool; sees /500 only
  SPECIAL_SCRUTINIZER // scrutinizer powers + tier allocation
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  FINAL_REVIEW // HoD approved; awaiting the 2 dean-assigned final reviewers
  APPROVED
  REJECTED
  WITHDRAWN
  HOLD
}

// Decision of a dean-assigned final reviewer (the layer above the HoD).
enum FinalDecision {
  PENDING
  APPROVED
  REJECTED
}

// W2 — per-proof verification state (incharge/HoD marks each proof link/file).
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FPGPStatus {
  DRAFT
  ACTIVE
  REVIEWED
  ACCEPTED
  NEEDS_REVIEW
}

enum ProjectType {
  MINI
  MAJOR
}

enum CourseLevel {
  BTECH
  MTECH
}

enum PublicationIndex {
  ESCI
  WOS
  SCOPUS
  ICI
  NONE
}

enum PatentStatus {
  FILED
  PUBLISHED
  GRANTED
}

enum ProjectStatus {
  APPLIED
  ONGOING
  COMPLETED
}

enum ReviewerRole {
  HOD
  REVIEWER
}

enum Scope {
  NATIONAL
  INTERNATIONAL
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// Faculty cadre bands (FAPA cadre-eligibility table). Assistant Professor splits
// by experience (< 3 yr / >= 3 yr) via the CadreTarget exp bounds; the others
// have a single band.
enum Cadre {
  ASSISTANT_PROFESSOR
  SR_ASSISTANT_PROFESSOR
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

// Patents/Projects/Consultancy requirement mode. DESIRABLE = suggested only
// (never blocks a tier); MANDATORY = must be met.
enum PpcRule {
  DESIRABLE
  MANDATORY
}

// Final appraisal tiers, T1 = highest.
enum Tier {
  T1
  T2
  T3
}

// Fixed calendar quarters aligned to the assessment period (01-Jul -> 30-Jun).
// Q1 Jul-Sep, Q2 Oct-Dec, Q3 Jan-Mar, Q4 Apr-Jun.
enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

// W6 — annual feedback lifecycle. DRAFT = HoD editing; ISSUED = released to faculty.
enum FeedbackStatus {
  DRAFT
  ISSUED
}

model User {
  id                    String    @id @default(uuid())
  employeeCode          String    @unique
  name                  String
  email                 String    @unique
  passwordHash          String
  dob                   DateTime?
  dateOfJoining         DateTime?
  designation           String?
  ratifiedDesignation   String?
  lastPromotionDate     DateTime?
  departmentId          String?
  payBand               String?
  gradePay              String?
  grossPay              Float?
  educationalQuals      String?
  specialization        String?
  periodOfServiceYears  Int?
  periodOfServiceMonths Int?
  expBeforeTeaching     Float?
  expBeforeIndustrial   Float?
  expBeforeResearch     Float?
  phone                 String?
  contactAddress        String?
  isActive              Boolean   @default(true)
  emailOptIn            Boolean   @default(true)
  // Bumped on logout / password change / password reset. Access and refresh
  // tokens carry the value they were signed with; a mismatch is rejected, so a
  // stolen token stops working the moment the user logs out or changes password.
  tokenVersion          Int       @default(0)
  // Set when someone other than the user chose the password (bulk import,
  // admin create). While true, `authenticate` lets the user do nothing but
  // change it. Cleared by change-password and the OTP forgot-password reset.
  mustChangePassword    Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  department       Department?           @relation(fields: [departmentId], references: [id])
  userRoles        UserRole[]
  appraisals       AppraisalSubmission[]
  fpgpPlans        FPGPPlan[]
  fpgpHodSigned    FPGPPlan[]            @relation("HoDSigner")
  reviewsGiven     AppraisalReview[]
  fpgpReviewsGiven FPGPReview[]
  auditLogs        AuditLog[]
  emails           EmailNotification[]
  passwordOtp      PasswordOtp?
  uploadedFiles    UploadedFile[]
  proofsVerified   ProofVerification[] @relation("ProofVerifier")
  snapshots        TrackingSnapshot[]
  feedbacks        Feedback[]          @relation("FeedbackFaculty")
  feedbacksIssued  Feedback[]          @relation("FeedbackIssuer")
  finalReviews     FinalReview[]       @relation("FinalReviewReviewer")
}

// Proof/evidence file ownership — used to authorize downloads (prevents IDOR
// via guessing/altering the filename in the URL).
model UploadedFile {
  id           String   @id @default(uuid())
  filename     String   @unique
  originalName String
  mimeType     String
  size         Int
  uploaderId   String
  createdAt    DateTime @default(now())

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users         User[]
  userRoles     UserRole[]
  academicYears AcademicYearDept[]
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  role         RoleType
  departmentId String?
  assignedBy   String
  assignedAt   DateTime @default(now())
  isActive     Boolean  @default(true)

  user       User        @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([userId, role, departmentId])
}

model AcademicYear {
  id             String   @id @default(uuid())
  label          String   @unique
  startDate      DateTime
  endDate        DateTime
  submissionOpen Boolean  @default(false)
  maxSubmissions Int      @default(4)
  createdAt      DateTime @default(now())

  deptSettings AcademicYearDept[]
  appraisals   AppraisalSubmission[]
  cadreTargets  CadreTarget[]
  cadreTiers    CadreTierThreshold[]
  snapshots     TrackingSnapshot[]
  feedbacks     Feedback[]
  reviewWindows ReviewWindow[]
}

// W8 — admin-configured quarterly review window per (AY, quarter). The quarterly
// snapshot + auto-feedback automation fires on the window's endDate; a daily
// checker runs any enabled window ending that day. Admin sets start/end freely.
model ReviewWindow {
  id             String   @id @default(uuid())
  academicYearId String
  quarter        Quarter
  startDate      DateTime
  endDate        DateTime
  enabled        Boolean  @default(true)
  lastRunAt      DateTime? // set when the automation fired, guards against re-runs
  // Mass-mail gate (2026-09-19). The window only emails faculty if the dean has
  // armed it after seeing a preview. A window that comes due unarmed still takes
  // its snapshot but holds the mail (heldAt) until the dean releases it.
  // Changing the dates disarms it again.
  armedAt        DateTime?
  armedById      String?
  heldAt         DateTime?
  releasedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, quarter])
}

// W4 — quarterly criteria-tracking snapshot per faculty (auto-generated by the
// quarterly scheduler). Rolling record of cadre/tier/eligibility standing.
model TrackingSnapshot {
  id             String   @id @default(uuid())
  userId         String
  academicYearId String
  quarter        Quarter
  cadre          Cadre?
  expYears       Float    @default(0)
  actuals        Json
  eligible       Boolean  @default(false)
  tier           Tier?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([userId, academicYearId, quarter])
}

// W6 — annual HoD feedback per submission. Auto-filled snapshot (scores + cadre
// + tier + eligibility gaps at issue time) plus HoD narrative; released to the
// faculty on issue.
model Feedback {
  id             String         @id @default(uuid())
  submissionId   String         @unique
  userId         String
  academicYearId String
  snapshot       Json
  strengths      String?
  improvements   String?
  growthTargets  String?
  status         FeedbackStatus @default(DRAFT)
  issuedById     String?
  issuedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  submission   AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User                @relation("FeedbackFaculty", fields: [userId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  issuedBy     User?               @relation("FeedbackIssuer", fields: [issuedById], references: [id])
}

// W7 — per-cadre tier thresholds. Replaces the global TierRule model: each
// (academicYear, cadre, tier) cell holds a flat per-criterion threshold set
// `{ [criterion]: { enabled, value } }` (see tierEngine TIER_CRITERIA). A tier
// is assigned when every ENABLED criterion meets-or-exceeds its value (AND, >=).
// Defaults seed from the cadre's CadreTarget row; admin-editable.
model CadreTierThreshold {
  id             String   @id @default(uuid())
  academicYearId String
  cadre          Cadre
  tier           Tier
  criteria       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, cadre, tier])
}

// Manual per-faculty decisions for a year. Neither tier nor eligibility is
// auto-computed any more — the admin/dean reviews each faculty's achievements
// against their cadre targets and sets both by hand. null = not yet decided.
// Scalar keys (no relations) keep it decoupled; read by trackingService.
model FacultyTier {
  id             String   @id @default(uuid())
  userId         String
  academicYearId String
  tier           Tier?
  eligible       Boolean? // dean's manual eligibility call; null = not yet decided
  assignedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, academicYearId])
  @@index([academicYearId])
}

// W1 — admin-configured per-AY cadre eligibility targets (FAPA table).
// Seeded from the FAPA AY2025-26 table, admin-editable. The eligibility/tier
// engine (W3) reads actuals against these rows.
model CadreTarget {
  id               String   @id @default(uuid())
  academicYearId   String
  cadre            Cadre
  minExpYears      Float    @default(0) // inclusive lower bound
  maxExpYears      Float? // exclusive upper bound; null = no upper bound
  totalScoreTarget Float
  feedbackTarget   Float
  indexedCount     Int
  minJournal       Int      @default(0)
  quartileSet      String? // e.g. "Q1-Q4", "Q1-Q3"; null = any quartile
  ppcRule          PpcRule
  ppcCount         Int // 1 or 2
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, cadre, minExpYears])
}

model AcademicYearDept {
  id             String  @id @default(uuid())
  academicYearId String
  departmentId   String
  submissionOpen Boolean @default(false)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])

  @@unique([academicYearId, departmentId])
}

model AppraisalSubmission {
  id               String           @id @default(uuid())
  userId           String
  academicYearId   String
  submissionNumber Int
  status           SubmissionStatus @default(DRAFT)
  submittedAt      DateTime?
  withdrawnAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  clLeaves           Int?
  elLeaves           Int?
  hplLeaves          Int?
  odLeaves           Int?
  otherLeaves        String?
  higherQualAcquired String?

  // W2 — reject/red-list. A rejected proof puts the submission on HOLD and
  // red-lists the faculty until the HoD clears it after re-upload.
  redListed  Boolean   @default(false)
  holdReason String?
  heldAt     DateTime?
  // Deadline for the faculty to replace a rejected proof. Stamped when the
  // submission goes on HOLD; once it passes, the daily job voids whatever is
  // still rejected rather than letting the appraisal stall forever.
  proofDeadlineAt DateTime?
  // PROOF_SOURCES keys (e.g. "cat2Journals") whose rows score zero because
  // their proof was rejected and never corrected. The scoring engine and its
  // frontend mirror both drop these rows, so the two stay in parity.
  voidedSources   String[]

  user         User         @relation(fields: [userId], references: [id])
  draftReview  DraftReview?
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  cat1Courses             Cat1Course[]
  cat1CourseResults       Cat1CourseResults[]
  cat1Projects            Cat1Project[]
  cat1EContent            Cat1EContent[]
  cat1ICT                 Cat1ICT[]
  cat2Journals            Cat2Journal[]
  cat2Conferences         Cat2Conference[]
  cat2ConfBookChapters    Cat2ConfBookChapter[]
  cat2BookChapters        Cat2BookChapter[]
  cat2Books               Cat2Book[]
  cat2Citations           Cat2Citations?
  cat2Patents             Cat2Patent[]
  cat2Projects            Cat2Project[]
  cat2Consultancy         Cat2Consultancy[]
  cat2Guidance            Cat2Guidance[]
  cat2ResearchGroups      Cat2ResearchGroup[]
  cat2Linkages            Cat2Linkage[]
  cat2Startups            Cat2Startup[]
  cat2IndustryLinkages    Cat2IndustryLinkage[]
  cat3AdvQual             Cat3AdvQual?
  cat3Organised           Cat3OrganisedProgram[]
  cat3ConferencesAttended Cat3ConferenceAttended[]
  cat3ResourcePerson      Cat3ResourcePerson[]
  cat3Editorial           Cat3Editorial[]
  cat3Training            Cat3Training[]
  cat3IntlTravel          Cat3IntlTravel[]
  cat4AdminResp           Cat4AdminResp[]
  cat4StudentAct          Cat4StudentActivity[]
  cat5Memberships         Cat5Membership[]
  cat5Awards              Cat5Award[]
  cat5Differentiators     Cat5Differentiator[]
  cat5Internships         Cat5Internship[]

  review             AppraisalReview?
  proofVerifications ProofVerification[]
  feedback           Feedback?
  finalReviews       FinalReview[]

  @@unique([userId, academicYearId, submissionNumber])
}

// W2 — one row per proof (link or uploaded file) referenced by a submission,
// carrying its section mapping + verification state. Records are synced from
// the submission's category rows on demand (the section map is derived, not
// stored at upload time). Keyed by (submissionId, url).
model ProofVerification {
  id           String             @id @default(uuid())
  submissionId String
  section      String // subsection label, e.g. "2.1 Journals"
  item         String // row identifier, e.g. the paper/patent title
  field        String // which proof field, e.g. "Proof" / "Index proof"
  url          String
  status       VerificationStatus @default(PENDING)
  verifiedById String?
  verifiedAt   DateTime?
  comment      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verifiedBy User?               @relation("ProofVerifier", fields: [verifiedById], references: [id])

  @@unique([submissionId, url])
}

model Cat1Course {
  id                  String      @id @default(uuid())
  submissionId        String
  courseName          String
  level               CourseLevel
  yearSem             String
  novelPedagogyUsed   Boolean     @default(false)
  novelPedagogyMethod String? // e.g. "Chalk and Talk", "Project Based Learning"
  periodPlanned       Int
  periodsConducted    Int

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// 1.2 Courses Taught — Attendance, Feedback, Results (per-course max 20, section max 80)
// A = (avgAttendancePct/100) * 5  (max 5)
// B = feedbackReceived  (max 5)
// C = (passPercentage/100) * 10  (max 10)
model Cat1CourseResults {
  id                String @id @default(uuid())
  submissionId      String
  courseName        String
  classSize         Int // Y — size of the class
  avgAttendancePct  Float  @default(0) // a — A = (a/100) * 5
  feedbackReceived  Float  @default(0) // B (out of 5)
  passPercentage    Float  @default(0) // P — C = (P/100) * 10

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat1Project {
  id           String      @id @default(uuid())
  submissionId String
  course       CourseLevel
  projectType  ProjectType
  count        Int

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat1EContent {
  id           String  @id @default(uuid())
  submissionId String
  courseName   String
  contentName  String
  nature       String
  evidenceFile String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat1ICT {
  id               String  @id @default(uuid())
  submissionId     String
  courseName       String
  platform         String
  natureOfUse      String
  otherDescription String? // legacy, no longer written: "Other" text is now stored in platform / natureOfUse themselves (2026-09-11)
  evidenceFile     String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Journal {
  id                 String           @id @default(uuid())
  submissionId       String
  title              String
  journalName        String
  authors            String
  authorPosition     String
  // 2.1 authorship claim (2026-09-15). authorList is the ordered author names;
  // `authors` stays filled (joined) for the PDF and older readers.
  authorList           String[] @default([])
  allAuthorsFromCampus Boolean? // null = not answered, and the paper scores 0
  claimedBySelf        Boolean? // all-VNRVJIET papers: true = the owner claims it; false = a co-author does (refused on save)
  volume             String?
  issueNo            String?
  pageNos            String?
  dateOfPub          DateTime?
  issn               String?
  doi                String?
  impactFactor       Float?
  impactFactorSource String? // e.g. Clarivate/SCImago/Google Scholar/Other
  indexed            PublicationIndex @default(NONE)
  quartile           String?
  proofFile          String?
  indexProofFile     String? // 2nd proof — the "index" page (proofFile is the 1st page)

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Conference {
  id                 String           @id @default(uuid())
  submissionId       String
  title              String
  conferenceName     String
  authors            String
  authorPosition     String
  // 2.1 authorship claim — see Cat2Journal.
  authorList           String[] @default([])
  allAuthorsFromCampus Boolean?
  claimedBySelf        Boolean?
  dateOfPub          DateTime?
  issn               String?
  doi                String?
  // The PDF's 2.1 columns apply to all three parts (added 2026-09-11).
  volume             String?
  issueNo            String?
  pageNos            String?
  impactFactor       Float?
  quartile           String?
  indexed            PublicationIndex @default(NONE)
  presentationStatus String? // Accepted / Presented / Other
  proofFile          String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2BookChapter {
  id             String  @id @default(uuid())
  submissionId   String
  title          String
  authors        String
  authorPosition String
  publisher      String?
  isbn           String?
  chapterNo      String?
  isEdited       Boolean @default(false)
  // National / International publisher. Null until the faculty chooses — an
  // unchosen row scores 0 (it defaulted to International = 10 until 2026-09-11).
  scope          Scope?
  proofFile      String? // cover/coverage proof

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// 2.1-C Conference-derived, indexed book chapters. Separate from Cat2BookChapter
// (the academic book-chapter table used in 2.3) — do not merge.
model Cat2ConfBookChapter {
  id             String           @id @default(uuid())
  submissionId   String
  title          String
  authors        String
  authorPosition String
  // 2.1 authorship claim — see Cat2Journal.
  authorList           String[] @default([])
  allAuthorsFromCampus Boolean?
  claimedBySelf        Boolean?
  conferenceName String
  // The PDF's 2.1 columns apply to all three parts (added 2026-09-11).
  dateOfPub      DateTime?
  issn           String?
  doi            String?
  volume         String?
  issueNo        String?
  pageNos        String?
  impactFactor   Float?
  quartile       String?
  indexed        PublicationIndex @default(NONE)
  proofFile      String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Book {
  id           String  @id @default(uuid())
  submissionId String
  title        String
  authors      String
  publisher    String?
  isbn         String?
  isEdited     Boolean @default(false)
  // National / International publisher. Null until chosen — scores 0 (see Cat2BookChapter).
  scope        Scope?
  proofFile    String? // cover/coverage proof

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Citations {
  id                String @id @default(uuid())
  submissionId      String @unique
  totalPubsTillDate Int    @default(0) // No. of Publications / Books till date
  pubsWithCitations Int    @default(0) // No. of publications/Books with Citations
  totalCitations    Int    @default(0) // Total No. of Citations (drives the score)
  hIndexGoogle      Int    @default(0)
  hIndexScopus      Int    @default(0)
  hIndexWos         Int    @default(0)

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Patent {
  id                   String       @id @default(uuid())
  submissionId         String
  title                String
  country              String
  inventors            String
  appNumber            String?
  status               PatentStatus
  iprType              String? // Patent/Copyright/Trademark/Design/Other
  iprTypeOther         String? // free text when iprType = Other
  patentType           String? // Utility / Process — for the cadre eligibility rule
  applicantIsInstitute Boolean      @default(false) // Institute-as-Applicant (eligibility rule)
  dateOfFiling         DateTime? // separate from dateOfPub
  dateOfPub            DateTime?
  dateOfGrant          DateTime?
  validDuration        String?
  proofFile            String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Project {
  id                String        @id @default(uuid())
  submissionId      String
  title             String
  fundingAgency     String
  amountLakhs       Float
  role              String
  status            ProjectStatus
  durationPeriod    String?
  dateOfApplication DateTime?
  dateOfGrant       DateTime? // project grant/sanction date, separate from dateOfApplication
  proofFile         String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Consultancy {
  id           String @id @default(uuid())
  submissionId String
  name         String
  agency       String
  amountLakhs  Float
  proofFile    String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Guidance {
  id           String  @id @default(uuid())
  submissionId String
  studentName  String
  university   String
  thesisTitle  String
  isGuide      Boolean @default(true)
  proofFile    String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2ResearchGroup {
  id           String @id @default(uuid())
  submissionId String
  groupName    String
  size         Int
  outcome      String
  proofFile    String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Linkage {
  id            String @id @default(uuid())
  submissionId  String
  instituteName String
  contactPerson String
  outcome       String
  proofFile     String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Cat2Startup {
  id           String @id @default(uuid())
  submissionId String
  groupName    String
  activity     String
  outcome      String
  proofFile    String?

  submission AppraisalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// 2.10 Industry linkage (max 10, score 5 per linkage)
model Cat2IndustryLinkage {
  id            String @id @default(uuid())
  submissionId  String
  industryName  String
  contactPerson String
  outcome       String
  proofFile     String?

