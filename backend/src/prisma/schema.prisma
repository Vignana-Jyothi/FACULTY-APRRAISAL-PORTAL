  totalExperienceSnap Float?

  // Digital ack signatures
  facultySignedAt DateTime?
  hodSignedAt     DateTime?
  hodSignedBy     String?

  // Year-end target reconciliation vs appraisal actuals
  evaluatedAt  DateTime?
  autoAccepted Boolean   @default(false)
  achievement  Json? // [{ subsection, key, target, achieved, met }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id])
  subsections FPGPSubsection[]
  reviews     FPGPReview[]
  hodSigner   User?            @relation("HoDSigner", fields: [hodSignedBy], references: [id])

  @@unique([userId, academicYearId])
}

